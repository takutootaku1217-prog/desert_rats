extends "res://tools/test_equipment_ui.gd"
func reveal_control(control):
 find_scroll(main.craft_ui._detail.get_parent()).ensure_control_visible(control)
 await frames()
func named(id:String):return main.craft_ui._detail.find_child(id,true,false)
func shot(name_:String):
 if DisplayServer.get_name()!="headless":
  await RenderingServer.frame_post_draw
  root.get_texture().get_image().save_png("/workspace/orders-ui/"+name_+".png")
func _initialize():
 main=load("res://scenes/main.tscn").instantiate();root.add_child(main);await frames()
 main.set_process(false)
 for w in main.workers:w.set_process(false)
 main.finish_build("workbench")
 main.storage.inventory.counts={GameData.Item.WOOD:2}
 main.craft_ui.open_entry("tool_wood_pick");await frames()
 check(not main.craft_ui._craft_btn.disabled,"倉庫だけに材料があれば注文可能")
 await reveal_control(main.craft_ui._craft_btn);await shot("warehouse-order")
 await click(main.craft_ui._craft_btn)
 check(main.production_orders.size()==1 and main.processor.incoming.is_empty(),"実クリックで待ち注文・材料は未予約")
 await reveal_control(named("CancelUnstarted"));await click(named("CancelUnstarted"))
 check(main.production_orders.is_empty() and main.storage.count_of(GameData.Item.WOOD)==2,"実クリック取消で倉庫を保持")
 var id:=str(GameData.Item.WOOD)
 await reveal_control(named("GoalQuantity"+id))
 var edit:LineEdit=named("GoalQuantity"+id).get_line_edit()
 await mouse(edit.get_global_rect().get_center(),MOUSE_BUTTON_LEFT)
 edit.select_all()
 var ev:=InputEventKey.new();ev.pressed=true;ev.keycode=KEY_5;ev.unicode=53;root.push_input(ev,true)
 await key(KEY_ENTER)
 await click(named("CollectGoal"+id))
 check(main.procurement_goals.get(GameData.Item.WOOD)==5,"実入力で採取目標数量5を登録")
 await click(named("CollectGoal"+id))
 check(main.procurement_goals.size()==1,"連打で重複目標を作らない")
 await shot("procurement-goal")
 await click(named("CancelGoal"+id))
 check(main.procurement_goals.is_empty(),"実入力で目標取消")
 main.craft_ui.open_entry("firewood");await frames()
 await reveal_control(named("RefillEnabled"));await click(named("RefillEnabled"))
 check(not main.refill_settings[GameData.Item.FUEL].enabled,"実入力で燃料補充OFF")
 await shot("refill-settings")
 await key(KEY_C)
 check(main.detail._live.has("carried") and main.detail._live.carried.text.contains("容量"),"個体画面で運搬容量・現在の仕事を表示")
 await frames();await shot("crew-cargo")
 print("== 結果: %s =="%("すべて成功" if fails==0 else "%d 件失敗"%fails));quit(1 if fails else 0)
